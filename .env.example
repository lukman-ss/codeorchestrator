# Server Configuration
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Authentication
REQUIRE_AUTH=true
ORCHESTRATOR_API_TOKEN=

# LLM Gateway & OpenCode
NINEROUTER_API_KEY=
OPENCODE_BIN=opencode
DEFAULT_MODEL=9router/ayce-combo
MAX_PROMPT_LENGTH=1000000

# Paths
ORCHESTRATOR_ROOT=/path/to/coding-orchestrator
WORKSPACE_ROOT=/path/to/workspace
DATABASE_PATH=/path/to/coding-orchestrator/data/orchestrator.db
AGENT_WORKTREE_ROOT=/path/to/workspace/.agent-worktrees

# Queue & Concurrency Limits
MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_TASKS_PER_PROJECT=1
TASK_TIMEOUT_SECONDS=3600
TASK_KILL_GRACE_SECONDS=10

# Multi-Agent Concurrency Limits
MAX_PARALLEL_WORKERS=3
MAX_PARALLEL_AUDITORS=2
MAX_PARALLEL_INTEGRATIONS=1
MAX_GLOBAL_AGENT_PROCESSES=5

# Agent Role Model Overrides (Optional, defaults to DEFAULT_MODEL)
SUPERVISOR_MODEL=
WORKER_MODEL=
AUDITOR_MODEL=
INTEGRATION_MODEL=
AUDIT_MODEL=
INTEGRATION_MODEL_OVERRIDE=

# Retry & Repair Policy
MAX_AUDIT_RETRIES=2
MAX_REPAIR_ATTEMPTS=2

# Logging Configuration
LOG_LEVEL=info
LOG_MAX_SIZE=20M
LOG_RETENTION_DAYS=7
LOG_MAX_FILES=10
TASK_LOG_MAX_SIZE=20M
TASK_LOG_RETENTION_DAYS=7

# Maintenance & Retention
TASK_EVENT_RETENTION_DAYS=7
TASK_EVENT_MAX_BYTES=65536
CLEANUP_INTERVAL_HOURS=24

# Disk Pressure Safeguards
MIN_FREE_DISK_MB=2048
MAX_DISK_USAGE_PERCENT=90
DISK_CHECK_INTERVAL_SECONDS=60

# Discord Bridge Service
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_GUILD_IDS=
# DISCORD_ALLOWED_CHANNEL_IDS is optional. When empty/unset, channels are discovered automatically
# and allowed based on Discord channel permissions and user authorization.
# To restrict execution to specific channels only, specify comma-separated channel IDs.
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
DISCORD_ALLOWED_PROJECTS=*
DISCORD_USER_PROJECTS={}
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
ORCHESTRATOR_API_URL=http://127.0.0.1:4000
ORCHESTRATOR_WS_URL=ws://127.0.0.1:4000/ws
DISCORD_DB_PATH=/path/to/coding-orchestrator/integrations/discord/data/bridge.db
PROGRESS_UPDATE_INTERVAL_MS=2000
POLL_INTERVAL_MS=5000
MAX_ATTACHMENT_BYTES=262144

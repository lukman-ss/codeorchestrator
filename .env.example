# Server Configuration
NODE_ENV=production
HOST=127.0.0.1
PORT=4000

# Authentication
REQUIRE_AUTH=true
ORCHESTRATOR_API_TOKEN=

# LLM Gateway & OpenCode
NINEROUTER_API_KEY=
OPENCODE_BIN=opencode
DEFAULT_MODEL=9router/ayce-combo
MAX_PROMPT_LENGTH=10000

# Paths
ORCHESTRATOR_ROOT=/path/to/coding-orchestrator
WORKSPACE_ROOT=/path/to/workspace
DATABASE_PATH=/path/to/coding-orchestrator/data/orchestrator.db
AGENT_WORKTREE_ROOT=/path/to/workspace/.agent-worktrees

# Queue & Concurrency Limits
MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_TASKS_PER_PROJECT=1
TASK_TIMEOUT_SECONDS=3600
TASK_KILL_GRACE_SECONDS=10

# Multi-Agent Concurrency Limits
MAX_PARALLEL_WORKERS=3
MAX_PARALLEL_AUDITORS=2
MAX_PARALLEL_INTEGRATIONS=1
MAX_GLOBAL_AGENT_PROCESSES=5

# Agent Role Model Overrides (Optional, defaults to DEFAULT_MODEL)
SUPERVISOR_MODEL=
WORKER_MODEL=
AUDITOR_MODEL=
INTEGRATION_MODEL=
AUDIT_MODEL=
INTEGRATION_MODEL_OVERRIDE=

# Retry & Repair Policy
MAX_AUDIT_RETRIES=2
MAX_REPAIR_ATTEMPTS=2

# Logging Configuration
LOG_LEVEL=info
LOG_MAX_SIZE=20M
LOG_RETENTION_DAYS=7
LOG_MAX_FILES=10
TASK_LOG_MAX_SIZE=20M
TASK_LOG_RETENTION_DAYS=7

# Maintenance & Retention
TASK_EVENT_RETENTION_DAYS=7
TASK_EVENT_MAX_BYTES=65536
CLEANUP_INTERVAL_HOURS=24

# Disk Pressure Safeguards
MIN_FREE_DISK_MB=2048
MAX_DISK_USAGE_PERCENT=90
DISK_CHECK_INTERVAL_SECONDS=60
